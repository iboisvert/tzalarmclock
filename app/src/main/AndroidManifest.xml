<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".TzAlarmClockApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TzAlarmClock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TzAlarmClock"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The standard android.provider.AlarmClock intents, so voice
          assistants and other apps can use this as the clock app. Guarded by
          SET_ALARM, as the platform clock app is; it's a normal permission,
          so any caller that declares it is granted it. Translucent with an
          empty task affinity: it shows nothing and finishes at once, and
          mustn't pull this app's task forward unless it opens MainActivity.
        -->
        <activity
            android:name=".AlarmClockIntentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <action android:name="android.intent.action.SNOOZE_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <action android:name="android.intent.action.DISMISS_TIMER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Not exported, no LAUNCHER intent-filter: only ever started by
          RingingService (directly, or via the notification's full-screen
          intent), never by the user or another app.
        -->
        <activity
            android:name=".AlarmRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.TzAlarmClock" />

        <!--
          Not exported, no LAUNCHER intent-filter: only ever started by
          TimerRingingService (directly, or via the notification's
          full-screen intent), never by the user or another app.
        -->
        <activity
            android:name=".TimerRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.TzAlarmClock" />
    </application>

</manifest>